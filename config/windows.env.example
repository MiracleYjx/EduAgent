# Copy to %LOCALAPPDATA%/EduAgent/config.env. Fill real values; never commit credentials.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/eduagent
REDIS_URL=redis://127.0.0.1:6379/0
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
VISION_MODEL=
# Cloud Embedding must actually support 1024 dimensions. Fill its own credentials.
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=1024
# Local build: choose local/bge with a complete external model directory.
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=D:/EduAgentModels/embedding
RERANK_PROVIDER=llm
CONFIDENCE_THRESHOLD=0.7
JWT_SECRET_KEY=
DEV_MODE=False
# Omit STORAGE_ROOT to use %LOCALAPPDATA%/EduAgent/storage for EXE.
# STORAGE_ROOT=D:/EduAgentData/storage
OCR_ENABLED=False
# If enabled, preinstall all 3 official T155 ONNX files externally.
OCR_PROVIDER=rapidocr
OCR_MODEL=PP-OCRv5-mobile
OCR_MODEL_DIR=
