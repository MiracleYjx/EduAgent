    def test_direct_answer_history_protects_question_even_without_current_exam_link(database):
        engine, info = database
        qid = info["questions"][0]
        with Session(engine) as session:
            student = add_user(session, UserRole.STUDENT, username="historical-student", email="historical-student@example.com")
            submission = Submission(exam_id=info["exam"], student_id=student.id, status=SubmissionStatus.DRAFT)
            session.add(submission)
            session.flush()
