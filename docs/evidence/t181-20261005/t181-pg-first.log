                    .with_for_update()
                ).one_or_none()
                if current is None:
                    raise GradingSubmissionNotFoundError(
                        f"答卷 {report.submission_id} 尚无整卷结果，拒绝写入诊断报告。"
                    )
                if report.exam_result_id not in {
                    str(current.id), f"exam-result:{report.submission_id}",
