# 复制为 .env 并填写真实连接信息和密钥；不要提交 .env。

DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>
REDIS_URL=redis://<host>:6379/0
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=<your-deepseek-api-key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 默认方案：本地 sentence-transformers；先安装 python -m pip install -e ".[rerank-local]"。
# huggingface / local 使用显式模型；bge 未填模型时默认 BAAI/bge-large-zh-v1.5。
# 三种本地入口加载 BGE 时均只为查询添加指令前缀。
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# 缺省为 1024；显式空值或与迁移 vector(1024) 不一致的配置禁止启动。
EMBEDDING_DIMENSION=1024
# 云端示例：EMBEDDING_PROVIDER=openai_compatible，并填写输出为 1024 维的模型及以下两项。
# 切换已有语料的 Embedding 模型须重新摄取，不可混用不同模型的向量。
# 其他本地入口示例：
# EMBEDDING_PROVIDER=bge
# EMBEDDING_PROVIDER=local
# 云端入口示例：
# EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# 默认方案：DeepSeek LLM Rerank，复用上述 DEEPSEEK_API_KEY / BASE_URL。
RERANK_PROVIDER=llm
RERANK_MODEL=deepseek-chat
# 手动备用：RERANK_PROVIDER=cross_encoder，RERANK_MODEL=BAAI/bge-reranker-base。
# 未填写 RERANK_MODEL 时，LLM 沿用 DEEPSEEK_MODEL，Cross Encoder 默认 bge-reranker-base。
# openai_compatible 是 LLM Rerank 路线别名；none 禁用重排，hybrid_rerank 模式将明确报错。
# LLM 失败不会自动切换备用路线。
CONFIDENCE_THRESHOLD=0.80
# 可选：Hybrid 检索中向量路的权重 α（0 到 1），默认 0.5；关键词路占 1-α。
HYBRID_VECTOR_WEIGHT=0.5
# 可选：单次 Rerank 的候选上限，默认 20；用于控制 LLM token 消耗。
RERANK_MAX_CANDIDATES=20
# 可选：LLM Rerank 单次调用超时秒数，默认 30。
RERANK_TIMEOUT_SECONDS=30

# 请替换为至少 32 个字符的随机密钥；占位值不能直接用于启动。
JWT_SECRET_KEY=请替换为至少32字符的随机密钥
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# 开发模式仅用于本地演示和测试；开启后会创建预设测试账号。
# 上线前必须将 DEV_MODE 设为 false，并清理数据库中的预设测试账号。
DEV_MODE=false
