# Copy this file to `.env` and replace the placeholders with real values.

DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>
REDIS_URL=redis://<host>:6379/0
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=<your-deepseek-api-key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=<your-deepseek-model>
EMBEDDING_PROVIDER=<embedding-provider>
# 云端 / 本地模型标识；local、huggingface 必填，bge 未填时使用 BAAI/bge-small-zh-v1.5。
EMBEDDING_MODEL=<embedding-model>
# 可选：向量维度；未填时由 Provider 或首次调用确定。
EMBEDDING_DIMENSION=
# 可选：仅在云端 Embedding API 需要时填写。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
RERANK_PROVIDER=<rerank-provider>
CONFIDENCE_THRESHOLD=0.80
# 可选：Hybrid 检索中向量路的权重 α（0 到 1），默认 0.5；关键词路占 1-α。
HYBRID_VECTOR_WEIGHT=0.5
# 可选：单次 Rerank 的候选上限，默认 20；用于控制 LLM token 消耗。
RERANK_MAX_CANDIDATES=20
# 可选：LLM Rerank 单次调用超时秒数，默认 30。
RERANK_TIMEOUT_SECONDS=30

# 请替换为至少 32 个字符的随机密钥；占位值不能直接用于启动。
JWT_SECRET_KEY=请替换为至少32字符的随机密钥
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# 开发模式仅用于本地演示和测试；开启后会创建预设测试账号。
# 上线前必须将 DEV_MODE 设为 false，并清理数据库中的预设测试账号。
DEV_MODE=false
