# Copy this file to `.env` and replace the placeholders with real values.

DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>
REDIS_URL=redis://<host>:6379/0
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=<your-deepseek-api-key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=<your-deepseek-model>
EMBEDDING_PROVIDER=<embedding-provider>
RERANK_PROVIDER=<rerank-provider>
CONFIDENCE_THRESHOLD=0.80

# 请替换为至少 32 个字符的随机密钥；占位值不能直接用于启动。
JWT_SECRET_KEY=请替换为至少32字符的随机密钥
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# 开发模式仅用于本地演示和测试；开启后会创建预设测试账号。
# 上线前必须将 DEV_MODE 设为 false，并清理数据库中的预设测试账号。
DEV_MODE=false
